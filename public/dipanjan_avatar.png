<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Radial Vignette: Deep Violet to Void -->
    <radialGradient id="cyberSky" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#240742" />
      <stop offset="60%" stop-color="#140428" />
      <stop offset="90%" stop-color="#090214" />
      <stop offset="100%" stop-color="#05010a" />
    </radialGradient>
    <radialGradient id="neonGlowOrange" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#FF7A00" stop-opacity="0.38" />
      <stop offset="60%" stop-color="#7F1DCB" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="suitGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#220D3D" />
      <stop offset="50%" stop-color="#16062A" />
      <stop offset="100%" stop-color="#0A0216" />
    </linearGradient>
    <linearGradient id="glassesReflection" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF5500" />
      <stop offset="45%" stop-color="#FF9900" />
      <stop offset="70%" stop-color="#A03AF0" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#1C0638" />
    </linearGradient>
    <clipPath id="circleClip">
      <circle cx="250" cy="250" r="240" />
    </clipPath>
  </defs>

  <g clip-path="url(#circleClip)">
    <!-- Dark fisheye background -->
    <rect width="500" height="500" fill="url(#cyberSky)" />
    
    <!-- Neon grid reflections / Skyscraper wireframes -->
    <path d="M70 250 Q250 60 430 250" fill="none" stroke="#FF7A00" stroke-width="1.5" stroke-opacity="0.6" />
    <path d="M100 250 Q250 100 400 250" fill="none" stroke="#FFAA00" stroke-width="1" stroke-opacity="0.4" />
    <path d="M40 250 Q250 20 460 250" fill="none" stroke="#A03AF0" stroke-width="1.5" stroke-opacity="0.5" />
    
    <!-- Background Skyscraper Blocks (Curved fisheye) -->
    <rect x="180" y="30" width="30" height="150" fill="#2E0B54" opacity="0.6" transform="rotate(-10 195 105)" />
    <rect x="235" y="15" width="34" height="160" fill="#420D75" opacity="0.7" />
    <rect x="290" y="35" width="28" height="145" fill="#2E0B54" opacity="0.6" transform="rotate(10 304 107)" />
    <circle cx="250" cy="220" r="220" fill="url(#neonGlowOrange)" />

    <!-- Shoulders & Suit -->
    <path d="M100 490 L130 360 L200 375 L250 420 L300 375 L370 360 L400 490 Z" fill="url(#suitGrad)" />
    
    <!-- White Shirt Collar -->
    <polygon points="215,368 250,420 232,420 205,372" fill="#F4E8FD" />
    <polygon points="285,368 250,420 268,420 295,372" fill="#FFFFFF" />

    <!-- Dark Violet / Indigo Necktie -->
    <polygon points="243,415 257,415 264,490 236,490" fill="#2A0B52" />
    <polygon points="241,412 259,412 254,430 246,430" fill="#3D1075" />

    <!-- Neck -->
    <path d="M222 320 C222 360 278 360 278 320 Z" fill="#b98068" />
    <path d="M228 335 C238 370 262 370 272 335 Z" fill="#9e6650" />

    <!-- Head & Face -->
    <ellipse cx="250" cy="245" rx="88" ry="102" fill="#cf957c" />
    <!-- Jaw and Chin -->
    <path d="M165 240 C165 315 210 345 250 345 C290 345 335 315 335 240 Z" fill="#c48a72" />
    <path d="M210 320 C235 338 265 338 290 320 C270 340 230 340 210 320 Z" fill="#a86e58" />

    <!-- Hair (Voluminous modern wave) -->
    <path d="M152 230 C145 165 200 135 250 135 C305 135 355 165 348 230 C335 185 305 155 250 155 C195 155 165 185 152 230 Z" fill="#150B20" />
    <path d="M155 215 C175 145 230 140 250 140 C280 140 330 150 345 205 C330 160 290 148 248 148 C198 148 170 175 155 215 Z" fill="#201133" />

    <!-- Ears -->
    <ellipse cx="160" cy="245" rx="10" ry="20" fill="#ba806a" />
    <ellipse cx="340" cy="245" rx="10" ry="20" fill="#ba806a" />

    <!-- Cyber Sunglasses Frame (Wrap-around shield) -->
    <path d="M168 215 C195 212 305 212 332 215 C338 235 332 268 318 272 C295 277 265 258 250 258 C235 258 205 277 182 272 C168 268 162 235 168 215 Z" fill="#0c0418" stroke="#FF7A00" stroke-width="1.5" />
    
    <!-- Left Lens (With Cyber Orange & Purple Reflection) -->
    <path d="M174 222 C196 220 242 220 245 235 C247 252 230 266 210 266 C190 266 172 250 174 222 Z" fill="url(#glassesReflection)" />
    <!-- Right Lens (With Cyber Orange & Purple Reflection) -->
    <path d="M326 222 C304 220 258 220 255 235 C253 252 270 266 290 266 C310 266 328 250 326 222 Z" fill="url(#glassesReflection)" />
    
    <!-- Sunglasses Glare Slits -->
    <line x1="180" y1="235" x2="238" y2="242" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
    <line x1="262" y1="242" x2="320" y2="235" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85" />

    <!-- Nose -->
    <path d="M246 265 L244 285 L256 285 L254 265" fill="#ab745e" opacity="0.7" />
    <ellipse cx="250" cy="287" rx="8" ry="4" fill="#9e6650" />

    <!-- Lips -->
    <path d="M232 308 Q250 314 268 308 Q250 320 232 308 Z" fill="#9f5d52" />
    <line x1="234" y1="309" x2="266" y2="309" stroke="#6b3730" stroke-width="1.5" />

    <!-- Neon Rim Lighting (Cyber Orange + Royal Purple) -->
    <path d="M165 240 C165 315 210 345 250 345" fill="none" stroke="#FF7A00" stroke-width="2.5" stroke-opacity="0.85" />
    <path d="M335 240 C335 315 290 345 250 345" fill="none" stroke="#A03AF0" stroke-width="2.5" stroke-opacity="0.85" />
  </g>

  <!-- Glowing Cyber Border Ring -->
  <circle cx="250" cy="250" r="242" fill="none" stroke="#FF7A00" stroke-width="4" stroke-opacity="0.85" />
</svg>
